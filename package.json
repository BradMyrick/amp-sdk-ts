{
  "name": "@amp/sdk",
  "version": "0.2.0",
  "description": "Avalanche Tournament & Bracket SDK — on-chain tournament prize pools (AMPTournamentCup.sol on Avalanche Fuji), EIP-712 verifier attestations, pull-payment prize claims, and zero-dependency bracket engine (Single Elimination, Swiss, Round Robin).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./engine": {
      "import": "./dist/engine/index.js",
      "types": "./dist/engine/index.d.ts"
    },
    "./bracket": {
      "import": "./dist/engine/index.js",
      "types": "./dist/engine/index.d.ts"
    },
    "./signers": {
      "import": "./dist/signers/index.js",
      "types": "./dist/signers/index.d.ts"
    },
    "./constants": {
      "import": "./dist/constants.js",
      "types": "./dist/constants.d.ts"
    },
    "./crypto": {
      "import": "./dist/crypto/helpers.js",
      "types": "./dist/crypto/helpers.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "amp",
    "avalanche",
    "tournament",
    "bracket",
    "single-elimination",
    "round-robin",
    "swiss",
    "prize-pool",
    "escrow",
    "eip-712",
    "fuji",
    "gaming",
    "web3",
    "esports"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BradMyrick/amp-sdk-ts.git"
  },
  "dependencies": {
    "ethers": "^6.13.0"
  },
  "peerDependencies": {
    "ethers": "^6.13.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0",
    "ethers": "^6.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
